# Copy to production.env and configure the production service before selecting this preset.
ALTOAIH_DESKTOP_APP_ID=com.altoaih.desktop
ALTOAIH_DESKTOP_AUTO_UPDATE_ENV=production
ALTOAIH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
ALTOAIH_DESKTOP_MACOS_PACK_CONCURRENCY=4
ALTOAIH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
ALTOAIH_DESKTOP_MACOS_DOWNLOAD_PROXY=
ALTOAIH_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# ALTOAIH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
