# Copy to test.env in the same machine configuration directory and fill in the values.
# Public test configuration. No PIN or upload credentials belong here.
ALTOAIH_DESKTOP_APP_ID=com.altoaih.desktop
ALTOAIH_DESKTOP_AUTO_UPDATE_ENV=test
ALTOAIH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
# Replace login.example.com with the real login origin before packaging.
ALTOAIH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
# Required for signed test packages; retain the release ID for an upgrade test batch.
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=
# Optional absolute private cache directory. Omit to retain the account default cache.
# ALTOAIH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
ALTOAIH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
ALTOAIH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

# Optional site-device manual release checks; use the real HTTPS website origin.
# Match the Host account authProtocol and platformOrigin. No release URL is guessed.
# ALTOAIH_DESKTOP_AUTH_PROTOCOL=site-device
# ALTOAIH_DESKTOP_SITE_ORIGIN=
