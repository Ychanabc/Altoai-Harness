# Nonsecret local Windows x64 unsigned-build template.
# Copy to apps/desktop/.env.windows only when that local file does not exist.
# Release settings are file-owned; shell exports do not replace this file.
# Do not add website tokens, signing credentials or upload credentials.
ALTOAIH_DESKTOP_APP_ID=eu.cc.vpss.altoai
ALTOAIH_DESKTOP_AUTH_PROTOCOL=site-device
ALTOAIH_DESKTOP_SITE_ORIGIN=https://ai.vpss.eu.cc
ALTOAIH_DESKTOP_WINDOWS_PACK_CONCURRENCY=4
ALTOAIH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
